{
  "$schema": "https://supabase.com/schema/storage-cors.json",
  "description": "Prompt Workshop - avatars 存储桶 CORS 策略（适配线上域名 szy050604.top）",
  "buckets": [
    {
      "bucket_id": "avatars",
      "cors": [
        {
          "allowed_origins": [
            "http://localhost:3000",
            "http://127.0.0.1:3000",
            "https://szy050604.top",
            "https://www.szy050604.top"
          ],
          "allowed_methods": [
            "GET",
            "POST",
            "PUT",
            "DELETE",
            "HEAD"
          ],
          "allowed_headers": [
            "*"
          ],
          "exposed_headers": [
            "Content-Length",
            "ETag"
          ],
          "max_age_seconds": 3600
        }
      ]
    }
  ],
  "note": "线上域名 CORS 已配置完成，支持 https://szy050604.top 和 https://www.szy050604.top"
}
